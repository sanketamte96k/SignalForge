# SignalForge Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual credentials.
# NEVER commit .env containing real credentials.

# Groww Trading API Credentials
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here
GROWW_API_BASE_URL=https://api.groww.in/v1
GROWW_REQUEST_TIMEOUT=30.0
