function App() {
  const [activeNav, setActiveNav] = useState('Dashboard')
  const [activeTimeframe, setActiveTimeframe] = useState('15m')
  const [activeSignalFilter, setActiveSignalFilter] = useState('All')
  const [search, setSearch] = useState('')
  const [sidebarOpen, setSidebarOpen] = useState(false)

  const currentTimeframe = timeframeData[activeTimeframe]

  const filteredSignals = useMemo(() => {
    let list = signals

    if (activeSignalFilter === 'NIFTY 50') {
      list = list.filter((s) => s[5] === 'NIFTY 50')
    } else if (activeSignalFilter === 'Watchlists') {
      const watchlistSymbols = new Set(
        Object.values(watchlists).flatMap((arr) => arr.map((item) => item[0])),
      )
      list = list.filter((s) => watchlistSymbols.has(s[0]))
    } else if (activeSignalFilter === 'Sectors') {
      list = list.filter((s) => s[5] !== 'NIFTY 50')
    }

    const query = search.trim().toLowerCase()
    if (!query) {
      return list
    }

    return list.filter((row) =>
      row.slice(0, 5).some((value) => value.toLowerCase().includes(query)),
    )
  }, [search, activeSignalFilter])

  const watchlistStocks = watchlists['My Watchlist']

  function handleNavigation(item) {
    setActiveNav(item)
    setSidebarOpen(false)
  }

  const signalClass =
    currentTimeframe.signal === 'BUY'
      ? 'buy'
      : currentTimeframe.signal === 'SELL'
      ? 'sell'
      : 'no-trade'

  return (
    <div className="terminal">
      {/* Mobile backdrop for drawer dismiss */}
      {sidebarOpen && (
        <div
          className="sidebar-backdrop"
          onClick={() => setSidebarOpen(false)}
          aria-hidden="true"
        />
      )}

      {/* 1. Left Sidebar */}
      <aside className={`sidebar ${sidebarOpen ? 'open' : ''}`}>
        <div className="sidebar-brand">
          <div className="logo-mark">
            <Icon type="arrow-up-right" />
          </div>

          <div>
            <div className="logo-name">SignalForge</div>
            <div className="logo-tagline">SCAN. ANALYZE. PROFIT.</div>
          </div>
        </div>

        <div className="sidebar-scroll">
          <div className="sidebar-title">MARKET WORKSPACE</div>

          <nav className="sidebar-nav">
            {navItems.map(([label, icon]) => (
              <button
                type="button"
                key={label}
                className={`sidebar-item ${
                  activeNav === label ? 'active' : ''
                }`}
                onClick={() => handleNavigation(label)}
              >
                <Icon type={icon} />
                <span>{label}</span>
              </button>
            ))}
          </nav>
        </div>

        <div className="sidebar-footer">
          <div className="sidebar-system-info">
            <div className="system-pill">
              <span className="live-dot" />
              <span>ALGO ENGINE ACTIVE</span>
            </div>
            <div className="system-sub">Signal Mode: MTF Precision</div>
          </div>

          <div className="sidebar-user">
            <div className="user-avatar">SA</div>

            <div className="user-details">
              <strong>SignalForge Terminal</strong>
              <span>Analytics Pro</span>
            </div>

            <button type="button" aria-label="User menu" className="user-more-btn">
              <Icon type="more-horizontal" />
            </button>
          </div>
        </div>
      </aside>

      <main className="main">
        {/* Top Search / Header & Market Status Data */}
        <header className="top-header">
          <button
            type="button"
            className="mobile-toggle"
            aria-label="Open navigation"
            onClick={() => setSidebarOpen((value) => !value)}
          >
            <span />
            <span />
            <span />
          </button>

          <div className="top-logo-mobile">
            <span className="mobile-logo-mark">
              <Icon type="arrow-up-right" />
            </span>
            <strong>SignalForge</strong>
          </div>

          <label className="global-search">
            <Icon type="search" />
            <input
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Search stocks, sectors, or watchlists..."
              aria-label="Search stocks, sectors, or watchlists"
            />
          </label>

          <div className="market-close">
            <span className="red-dot" />
            <strong>Market Close In</strong>
            <span className="market-countdown">01:26:37</span>
          </div>

          <div className="top-market-data">
            <TopMarket
              icon="fii"
              label="FII / DII"
              value="+1,256 Cr"
              change="+0.42%"
            />

            <TopMarket
              icon="globe"
              label="Global Markets"
              value="S&P 500"
              change="+0.82%"
            />

            <TopMarket
              icon="barrel"
              label="Crude Oil"
              value="$78.24"
              change="+0.36%"
            />

            <TopMarket
              icon="currency"
              label="USD / INR"
              value="83.27"
              change="-0.12%"
              negative
            />
          </div>

          <div className="header-actions">
            <button
              type="button"
              className="notification-btn"
              aria-label="Notifications"
            >
              <Icon type="bell" />
              <span className="notification-badge">3</span>
            </button>

            <button
              type="button"
              className="header-user-btn"
              aria-label="Account profile"
            >
              <div className="header-avatar">SA</div>
              <Icon type="chevron-down" />
            </button>
          </div>
        </header>

        <div className="content">
          {/* Top Section: LARGE NIFTY 50 CHART (67-70%) + NIFTY 50 LIVE SIGNAL (30-33%) */}
          <section className="main-grid">
            {/* Large NIFTY 50 Analysis Panel */}
            <div className="nifty-panel panel">
              <div className="panel-header nifty-header">
                <div className="nifty-title">
                  <h1>NIFTY 50</h1>

                  <div className="timeframe-tabs">
                    {Object.keys(timeframeData).map((timeframe) => (
                      <button
                        type="button"
                        key={timeframe}
                        className={
                          activeTimeframe === timeframe ? 'active' : ''
                        }
                        onClick={() => setActiveTimeframe(timeframe)}
                      >
                        {timeframe}
                      </button>
                    ))}
                  </div>
                </div>

                <div className="chart-actions">
                  <button type="button">
                    <Icon type="indicator" />
                    <span>Indicators</span>
                  </button>

                  <button type="button">
                    <Icon type="template" />
                    <span>Templates</span>
                  </button>

                  <button type="button" aria-label="Fullscreen" title="Fullscreen">
                    <Icon type="fullscreen" />
                  </button>
                </div>
              </div>

              {/* OHLC Row */}
              <div className="ohlc-row">
                <span>
                  O <strong>24,185.10</strong>
                </span>
                <span className="positive">
                  H <strong>24,220.35</strong>
                </span>
                <span className="negative">
                  L <strong>24,175.60</strong>
                </span>
                <span className="positive">
                  C <strong>{currentTimeframe.close}</strong>
                </span>
                <span className={`ohlc-change ${currentTimeframe.change.startsWith('-') ? 'negative' : 'positive'}`}>
                  {currentTimeframe.change}
                </span>
              </div>

              {/* Chart Legend */}
              <div className="chart-legend">
                <span className="legend-item blue">
                  <span className="legend-marker marker-blue" />
                  EMA 20 <strong>24,185.12</strong>
                </span>
                <span className="legend-item orange">
                  <span className="legend-marker marker-orange" />
                  EMA 50 <strong>24,142.67</strong>
                </span>
                <span className="legend-item purple">
                  <span className="legend-marker marker-purple" />
                  EMA 200 <strong>24,010.34</strong>
                </span>
                <span className="legend-item volume">
                  <span className="legend-marker marker-volume" />
                  Volume <strong>12.4M</strong>
                </span>
              </div>

              {/* Candlestick-style chart (Expanded Height) */}
              <div className="candlestick-chart">
                <PriceChart />
              </div>

              {/* RSI panel (Enhanced & Readable) */}
              <div className="rsi-panel">
                <div className="rsi-label">
                  RSI (14) <strong>{currentTimeframe.rsi}</strong>
                </div>
                <RsiChart />
              </div>
            </div>

            {/* NIFTY 50 — Live Signal Panel */}
            <div className="signal-panel panel">
              <div className="panel-header signal-panel-header">
                <div className="signal-header-left">
                  <h2>NIFTY 50 — Live Signal</h2>
                </div>
                <div className="signal-header-right">
                  <span className="signal-live-badge">
                    <span className="signal-live-dot" />
                    Live
                  </span>
                  <span className="signal-tf-tag">{activeTimeframe}</span>
                </div>
              </div>

              <div className="signal-content">
                {/* 1. Visually Dominant BUY / SELL / NO TRADE status */}
                <div className="signal-badge-section">
                  <div className="signal-tag-label">ALGORITHMIC SIGNAL</div>
                  <div className={`signal-dominant-box ${signalClass}`}>
                    <div className="signal-dominant-text">{currentTimeframe.signal}</div>
                    <div className="signal-dominant-sub">
                      {currentTimeframe.signal === 'BUY'
                        ? 'BULLISH MTF CONFLUENCE'
                        : currentTimeframe.signal === 'SELL'
                        ? 'BEARISH DISTRIBUTION'
                        : 'WAIT FOR TRADE SETUP'}
                    </div>
                  </div>
                </div>

                {/* 2. Key Instrument & Price Metrics */}
                <div className="signal-metrics-list">
                  <div className="signal-metric-row">
                    <span className="detail-muted">Instrument</span>
                    <strong className="instrument-title">NIFTY 50 Index</strong>
                  </div>
                  <div className="signal-metric-row">
                    <span className="detail-muted">Current Price</span>
                    <strong className="numeric-val tabular-num">{currentTimeframe.price}</strong>
                  </div>
                  <div className="signal-metric-row">
                    <span className="detail-muted">Signal Timestamp</span>
                    <strong className="numeric-val tabular-num">{currentTimeframe.time}</strong>
                  </div>
                  <div className="signal-metric-row">
                    <span className="detail-muted">Selected Timeframe</span>
                    <strong className="timeframe-tag">{activeTimeframe}</strong>
                  </div>
                  <div className="signal-metric-row">
                    <span className="detail-muted">Signal Reason</span>
                    <strong className="reason-val">{currentTimeframe.reason}</strong>
                  </div>
                </div>

                {/* 3. Confirmation Factors */}
                <div className="confirmation-section">
                  <div className="confirmation-header">
                    <span className="detail-muted-title">CONFIRMATION FACTORS</span>
                    <span className="confirmation-status-pill">
                      {currentTimeframe.signal === 'BUY' || currentTimeframe.signal === 'SELL'
                        ? '4 / 4 Confirmed'
                        : '2 / 4 Pending'}
                    </span>
                  </div>

                  <div className="factor-list">
                    <div className={`factor-item ${currentTimeframe.signal === 'NO TRADE' ? 'factor-neutral' : 'factor-confirmed'}`}>
                      <span className="factor-icon-wrap">
                        <Icon type={currentTimeframe.signal === 'NO TRADE' ? 'alert-circle' : 'check-small'} />
                      </span>
                      <div className="factor-text">
                        <strong>EMA Confirmation</strong>
                        <span>{currentTimeframe.emaConf}</span>
                      </div>
                    </div>

                    <div className={`factor-item ${currentTimeframe.signal === 'NO TRADE' ? 'factor-neutral' : 'factor-confirmed'}`}>
                      <span className="factor-icon-wrap">
                        <Icon type={currentTimeframe.signal === 'NO TRADE' ? 'alert-circle' : 'check-small'} />
                      </span>
                      <div className="factor-text">
                        <strong>RSI + Momentum</strong>
                        <span>{currentTimeframe.rsiMom}</span>
                      </div>
                    </div>

                    <div className={`factor-item ${currentTimeframe.signal === 'NO TRADE' ? 'factor-neutral' : 'factor-confirmed'}`}>
                      <span className="factor-icon-wrap">
                        <Icon type={currentTimeframe.signal === 'NO TRADE' ? 'alert-circle' : 'check-small'} />
                      </span>
                      <div className="factor-text">
                        <strong>Volume Confirmation</strong>
                        <span>{currentTimeframe.volConf}</span>
                      </div>
                    </div>

                    <div className={`factor-item ${currentTimeframe.signal === 'NO TRADE' ? 'factor-neutral' : 'factor-confirmed'}`}>
                      <span className="factor-icon-wrap">
                        <Icon type={currentTimeframe.signal === 'NO TRADE' ? 'alert-circle' : 'check-small'} />
                      </span>
                      <div className="factor-text">
                        <strong>Multi-Timeframe Alignment</strong>
                        <span>{currentTimeframe.mtfAlign}</span>
                      </div>
                    </div>
                  </div>
                </div>

                {/* 4. Stop Loss, Target 1, Target 2 with Percentage Distances */}
                <div className="trade-levels-section">
                  <span className="detail-muted-title">EXECUTION TARGETS & STOP LOSS</span>
                  <div className="trade-levels-grid">
                    <div className="trade-level-card sl">
                      <div className="level-badge sl-badge">SL</div>
                      <div className="level-info">
                        <span className="level-title">Stop Loss</span>
                        <strong className="negative tabular-num">{currentTimeframe.slPrice}</strong>
                        <span className="level-pct negative tabular-num">{currentTimeframe.slPct}</span>
                      </div>
                    </div>

                    <div className="trade-level-card t1">
                      <div className="level-badge t1-badge">T1</div>
                      <div className="level-info">
                        <span className="level-title">Target 1</span>
                        <strong className="positive tabular-num">{currentTimeframe.t1Price}</strong>
                        <span className="level-pct positive tabular-num">{currentTimeframe.t1Pct}</span>
                      </div>
                    </div>

                    <div className="trade-level-card t2">
                      <div className="level-badge t2-badge">T2</div>
                      <div className="level-info">
                        <span className="level-title">Target 2</span>
                        <strong className="positive tabular-num">{currentTimeframe.t2Price}</strong>
                        <span className="level-pct positive tabular-num">{currentTimeframe.t2Pct}</span>
                      </div>
                    </div>
                  </div>
                </div>

                {/* 5. View Full Analysis Action */}
                <button type="button" className="full-analysis-btn">
                  <span>View Full Analysis</span>
                  <Icon type="arrow-right" />
                </button>
              </div>
            </div>
          </section>

          {/* Lower Section: Top Signals Today, Sector Performance, Watchlists */}
          <section className="lower-grid">
            {/* Top Signals Today */}
            <div className="panel signals-panel">
              <PanelTitle title="Top Signals Today" action="View All" />

              <div className="filter-tabs">
                {['All', 'NIFTY 50', 'Watchlists', 'Sectors'].map(
                  (tab) => (
                    <button
                      type="button"
                      className={activeSignalFilter === tab ? 'active' : ''}
                      key={tab}
                      onClick={() => setActiveSignalFilter(tab)}
                    >
                      {tab}
                    </button>
                  ),
                )}
              </div>

              <div className="table-wrapper">
                <div className="signals-table">
                  <div className="table-head">
                    <span>Symbol</span>
                    <span className="text-right">Price</span>
                    <span className="text-center">Signal</span>
                    <span className="text-right">Change</span>
                    <span className="text-right">Time</span>
                  </div>

                  {filteredSignals.map(
                    ([symbol, price, signal, change, time]) => (
                      <div className="signal-row" key={symbol}>
                        <strong>{symbol}</strong>
                        <span className="text-right tabular-num">{price}</span>
                        <div className="badge-cell">
                          <SignalBadge value={signal} />
                        </div>
                        <span
                          className={`text-right tabular-num ${
                            change.startsWith('+')
                              ? 'positive'
                              : 'negative'
                          }`}
                        >
                          {change}
                        </span>
                        <span className="text-right tabular-num text-muted">{time}</span>
                      </div>
                    ),
                  )}
                </div>
              </div>
            </div>

            {/* Sector Performance */}
            <div className="panel sector-panel">
              <PanelTitle
                title="Sector Performance"
                action="View All"
                extra={
                  <div className="period-selector">
                    <span>1D</span>
                    <Icon type="chevron-down" />
                  </div>
                }
              />

              <div className="table-wrapper">
                <div className="sector-heading">
                  <span>Sector</span>
                  <span className="text-right">Change</span>
                  <span className="text-left">Relative Trend</span>
                </div>

                <div className="sector-list">
                  {sectors.map(
                    ([name, change, width, isPositive]) => (
                      <div className="sector-row" key={name}>
                        <span className="sector-name">{name}</span>
                        <strong
                          className={`text-right tabular-num ${
                            isPositive ? 'positive' : 'negative'
                          }`}
                        >
                          {change}
                        </strong>
                        <div className="sector-bar">
                          <span
                            className={
                              isPositive
                                ? 'positive-bar'
                                : 'negative-bar'
                            }
                            style={{ width: `${width}%` }}
                          />
                        </div>
                      </div>
                    ),
                  )}
                </div>
              </div>
            </div>

            {/* Watchlists */}
            <div className="panel watchlist-panel">
              <PanelTitle title="Watchlists" action="View All" />

              <div className="watchlist-tabs">
                {['My Watchlist', 'Tech', 'Banking', 'High Volatility'].map((tab) => (
                  <button
                    type="button"
                    key={tab}
                    className={tab === 'My Watchlist' ? 'active' : ''}
                  >
                    {tab}
                  </button>
                ))}
              </div>

              <div className="table-wrapper">
                <div className="watchlist-table">
                  <div className="table-head">
                    <span>Symbol</span>
                    <span className="text-right">Price</span>
                    <span className="text-right">Change</span>
                    <span className="text-center">Signal</span>
                  </div>

                  {watchlistStocks.map(
                    ([symbol, price, change, signal]) => (
                      <div className="watch-row" key={symbol}>
                        <strong>{symbol}</strong>
                        <span className="text-right tabular-num">{price}</span>
                        <span
                          className={`text-right tabular-num ${
                            change.startsWith('+')
                              ? 'positive'
                              : 'negative'
                          }`}
                        >
                          {change}
                        </span>
                        <div className="badge-cell">
                          <SignalBadge value={signal} />
                        </div>
                      </div>
                    ),
                  )}
                </div>
              </div>
            </div>
          </section>

          {/* Bottom Section: Stock Validation, Paper Trading, Recent Activity */}
          <section className="bottom-grid">
            {/* Stock Validation */}
            <div className="panel validation-panel">
              <PanelTitle title="Stock Validation" action="View All" />

              <div className="validation-content">
                <ValidationRing />

                <div className="validation-legend">
                  <ValidationItem
                    label="Validated"
                    value="42"
                    className="validated"
                  />
                  <ValidationItem
                    label="In Progress"
                    value="5"
                    className="progress"
                  />
                  <ValidationItem
                    label="Pending"
                    value="2"
                    className="pending"
                  />
                  <ValidationItem
                    label="Failed"
                    value="1"
                    className="failed"
                  />
                </div>
              </div>

              <button type="button" className="add-stock-button">
                <span>Add New Stock</span>
                <Icon type="arrow-right" />
              </button>
            </div>

            {/* Paper Trading */}
            <div className="panel paper-panel">
              <PanelTitle
                title="Paper Trading"
                action="View All"
                badge={
                  <span className="paper-mode-badge">
                    <i />
                    Paper Mode
                  </span>
                }
              />

              <div className="paper-stats">
                <Metric
                  label="Total P&L"
                  value="+12,430"
                  sub="+1.24%"
                  positive
                />
                <Metric label="Open Positions" value="3" />
                <Metric label="Win Rate" value="68%" />
                <Metric label="Total Trades" value="48" />
              </div>

              <div className="equity-chart">
                <EquityChart />
              </div>

              <div className="months">
                <span>Jan</span>
                <span>Feb</span>
                <span>Mar</span>
                <span>Apr</span>
                <span>May</span>
                <span>Jun</span>
                <span>Jul</span>
                <span>Aug</span>
              </div>
            </div>

            {/* Recent Activity */}
            <div className="panel activity-panel">
              <PanelTitle title="Recent Activity" action="View All" />

              <div className="table-wrapper">
                <div className="activity-table">
                  <div className="activity-heading">
                    <span>Time</span>
                    <span>Event</span>
                    <span>Details</span>
                  </div>

                  {activity.map(
                    ([time, event, details, type]) => (
                      <div
                        className="activity-row"
                        key={`${time}-${event}`}
                      >
                        <span className="tabular-num text-muted">{time}</span>
                        <strong className={`activity-badge ${type}`}>{event}</strong>
                        <span className="activity-details">{details}</span>
                      </div>
                    ),
                  )}
                </div>
              </div>
            </div>
          </section>

          {/* Institutional Footer */}
          <footer className="footer">
            <div className="footer-left">
              <div className="footer-logo">
                <Icon type="arrow-up-right" />
              </div>
              <strong>SignalForge</strong>
              <span>Scan. Analyze. Profit.</span>
            </div>

            <div className="system-operational">
              <i />
              All Systems Operational
            </div>

            <span className="version">v1.0.0</span>
          </footer>
        </div>

        {/* Mobile Bottom Navigation */}
        <nav className="mobile-nav">
          {[
            ['Dashboard', 'dashboard'],
            ['NIFTY', 'chart'],
            ['Scanner', 'search'],
            ['Watchlists', 'bookmark'],
            ['Paper', 'briefcase'],
          ].map(([label, icon]) => (
            <button
              type="button"
              key={label}
              className={
                activeNav === label ||
                (label === 'NIFTY' &&
                  activeNav === 'NIFTY Analysis')
                  ? 'active'
                  : ''
              }
              onClick={() =>
                handleNavigation(
                  label === 'NIFTY'
                    ? 'NIFTY Analysis'
                    : label,
                )
              }
            >
              <Icon type={icon} />
              <span>{label}</span>
            </button>
          ))}
        </nav>
      </main>
    </div>
  )
}

function TopMarket({ icon, label, value, change, negative }) {
  return (
    <div className="top-market-item">
      <span className="market-icon">
        <MarketIcon type={icon} />
      </span>

      <div className="market-content">
        <small>{label}</small>

        <div className="market-row">
          <strong>{value}</strong>
          <span className={negative ? 'negative' : 'positive'}>
            {change}
          </span>
        </div>
      </div>
    </div>
  )
}

function MarketIcon({ type }) {
  if (type === 'fii') {
    return (
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
        <polygon points="8,1 15,8 8,15 1,8" />
      </svg>
    )
  }
  if (type === 'globe') {
    return (
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
        <circle cx="8" cy="8" r="6.5" />
        <line x1="1.5" y1="8" x2="14.5" y2="8" />
        <path d="M8 1.5a10 10 0 0 1 0 13 10 10 0 0 1 0-13" />
      </svg>
    )
  }
  if (type === 'barrel') {
    return (
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
        <ellipse cx="8" cy="3.5" rx="5.5" ry="2" />
        <path d="M2.5 3.5v9c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-9" />
        <path d="M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2" />
      </svg>
    )
  }
  return (
    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <circle cx="8" cy="8" r="6.5" />
      <path d="M6 5.5h4M6 8h4M7 8a2 2 0 0 0 2-2M7.5 10.5 10 13" />
    </svg>
  )
}

