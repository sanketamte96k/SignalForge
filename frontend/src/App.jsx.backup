    ),
  }

  return (
    <svg
      className="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="1.8"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      {icons[type]}
    </svg>
  )
}

function PriceChart() {
  const candles = [
    [38, 74, 110, 92, 'down'],
    [62, 87, 124, 101, 'down'],
    [86, 96, 138, 111, 'down'],
    [110, 106, 151, 122, 'down'],
    [134, 115, 165, 132, 'down'],
    [158, 124, 181, 139, 'down'],
    [182, 133, 198, 149, 'down'],
    [206, 142, 210, 156, 'up'],
    [230, 143, 173, 151, 'up'],
    [254, 136, 171, 145, 'up'],
    [278, 132, 166, 141, 'down'],
    [302, 127, 159, 136, 'up'],
    [326, 121, 153, 130, 'up'],
    [350, 117, 147, 125, 'down'],
    [374, 111, 144, 120, 'up'],
    [398, 104, 137, 113, 'up'],
    [422, 98, 131, 107, 'down'],
    [446, 95, 126, 103, 'up'],
    [470, 90, 121, 99, 'up'],
    [494, 86, 117, 94, 'down'],
    [518, 82, 113, 90, 'up'],
    [542, 77, 109, 86, 'up'],
    [566, 73, 104, 81, 'up'],
    [590, 69, 101, 77, 'down'],
    [614, 64, 97, 73, 'up'],
    [638, 60, 94, 69, 'up'],
    [662, 56, 90, 64, 'down'],
    [686, 52, 86, 61, 'up'],
    [710, 47, 81, 56, 'up'],
    [734, 42, 78, 51, 'up'],
    [758, 37, 74, 46, 'up'],
  ]

  const volumes = [
    34, 51, 43, 63, 48, 70, 57, 44,
    62, 49, 76, 53, 65, 46, 58, 71,
    52, 67, 59, 47, 74, 54, 63, 49,
    68, 57, 72, 61, 76, 66, 84,
  ]

  return (
    <svg
      className="price-svg"
      viewBox="0 0 780 330"
      preserveAspectRatio="none"
    >
      {[38, 96, 154, 212, 270].map((y) => (
        <line
          key={y}
          x1="0"
          y1={y}
          x2="780"
          y2={y}
          className="grid-line"
        />
      ))}

      {[0, 130, 260, 390, 520, 650, 780].map((x) => (
        <line
          key={x}
          x1={x}
          y1="0"
          x2={x}
          y2="292"
          className="vertical-grid"
        />
      ))}

      <path
        d="M0 205 C70 211 126 231 190 246 C248 260 298 245 350 214 C403 184 452 201 503 169 C553 137 597 150 646 117 C695 84 735 77 780 58"
        className="ema-blue"
      />

      <path
        d="M0 218 C72 224 128 239 190 250 C252 261 302 252 352 229 C405 204 451 214 505 185 C555 158 600 166 650 137 C700 108 742 98 780 80"
        className="ema-orange"
      />

      <path
        d="M0 253 C105 251 186 256 270 251 C360 246 441 239 522 218 C607 196 695 177 780 154"
        className="ema-purple"
      />

      {candles.map(
        ([x, top, low, close, direction], index) => {
          const high = Math.max(top - 18, 10)
          const candleLow = Math.min(low + 18, 286)
          const width = 8
          const bodyTop = Math.min(top, close)
          const bodyHeight = Math.max(
            Math.abs(close - top),
            5,
          )
          const candleColor =
            direction === 'up' ? '#00d9a3' : '#ff4f5e'

          return (
            <g key={index}>
              <line
                x1={x}
                y1={high}
                x2={x}
                y2={candleLow}
                stroke={candleColor}
                strokeWidth="1.4"
              />

              <rect
                x={x - width / 2}
                y={bodyTop}
                width={width}
                height={bodyHeight}
                fill={candleColor}
                rx="1"
              />
            </g>
          )
        },
      )}

      {volumes.map((height, index) => {
        const x = 14 + index * 25.2
        const candle = candles[index]
        const color =
          candle?.[4] === 'up'
            ? 'volume-green'
            : 'volume-red'

        return (
          <rect
            key={`volume-${index}`}
            x={x}
            y={294 - height}
            width="10"
            height={height}
            rx="1"
            className={color}
          />
        )
      })}

      <line
        x1="758"
        y1="0"
        x2="758"
        y2="292"
        className="current-price-line"
      />

      <rect
        x="704"
        y="27"
        width="76"
        height="22"
        rx="4"
        className="price-label-box"
      />

      <text
        x="742"
        y="42"
        textAnchor="middle"
        className="price-label"
      >
        24,213.45
      </text>
    </svg>
  )
}

